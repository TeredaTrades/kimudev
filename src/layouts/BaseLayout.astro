---
import '../styles/global.css';
import { withBase, NAV_LINKS } from '../lib/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{title} · KimuDev</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={withBase('/')}>KimuDev</a>
        <nav aria-label="Primary">
          {NAV_LINKS.map((link) => (
            <a href={withBase(link.href)}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>&copy; {year} KimuDev.</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.35rem clamp(1.25rem, 4vw, 3rem);
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 0.01em;
      }
      .site-header nav {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .site-header nav a {
        text-decoration: none;
        font-size: 0.95rem;
        color: var(--text-muted);
      }
      .site-header nav a:hover {
        color: var(--text);
      }
      .site-footer {
        border-top: 1px solid var(--line);
        padding: 2.5rem 0 3rem;
      }
      .footer-inner p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
      }
    </style>

    <script>
      const SCRAMBLE_GLYPHS = '01ABCDEFGHIJKLMNOPQRSTUVWXYZ$%#@!<>/\\{}[]*+-';

      function scrambleEl(el) {
        if (el.dataset.scrambling === '1') return;
        const original = el.textContent || '';
        if (!original.trim()) return;
        el.dataset.scrambling = '1';
        const len = original.length;
        const totalFrames = Math.min(50, Math.max(12, Math.floor(len * 0.8)));
        let frame = 0;
        const timer = setInterval(() => {
          frame++;
          const revealCount = Math.floor((frame / totalFrames) * len);
          let out = '';
          for (let i = 0; i < len; i++) {
            if (original[i] === ' ') {
              out += ' ';
            } else if (i < revealCount) {
              out += original[i];
            } else {
              out += SCRAMBLE_GLYPHS[(Math.random() * SCRAMBLE_GLYPHS.length) | 0];
            }
          }
          el.textContent = out;
          if (frame >= totalFrames) {
            el.textContent = original;
            clearInterval(timer);
            el.dataset.scrambling = '0';
          }
        }, 35);
      }

      function initScramble() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;
        const targets = document.querySelectorAll('.wordmark, .site-header nav a, main h1');
        targets.forEach((el) => {
          el.addEventListener('mouseenter', () => scrambleEl(el));
        });
      }

      document.addEventListener('DOMContentLoaded', initScramble);
    </script>
  </body>
</html>
