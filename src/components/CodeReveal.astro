---
// Digital rain that never stops falling in the background. Every so
// often the falling rain "builds" the word KimuDev cell by cell over
// ~1.5s (not an instant snap), gives it a brief glow once fully
// formed, holds it for a few seconds, then gradually washes it away
// over ~1.5s before the cycle repeats. Respects prefers-reduced-motion:
// renders the word once, statically, with no animation at all.
---

<div class="code-reveal-wrap">
  <canvas id="code-reveal" aria-hidden="true"></canvas>
</div>

<style>
  .code-reveal-wrap {
    width: 100%;
    max-width: 640px;
    aspect-ratio: 640 / 180;
    margin: 0 auto;
  }
  #code-reveal {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const RAIN_GAP_MS = 1600; // pure rain before each formation starts
  const CONVERGE_MS = 1500; // time for the rain to build the word
  const GLOW_MS = 500; // brief glow pulse once fully formed
  const HOLD_MS = 6000; // how long the formed word stays lit
  const DISSOLVE_MS = 1500; // time for the rain to wash the word away

  function hexToRgba(hex, alpha) {
    const h = hex.trim().replace('#', '');
    const full = h.length === 3 ? h.split('').map((x) => x + x).join('') : h;
    const bigint = parseInt(full, 16);
    const r = (bigint >> 16) & 255;
    const g = (bigint >> 8) & 255;
    const b = bigint & 255;
    return `rgba(${r},${g},${b},${alpha})`;
  }

  function initCodeReveal() {
    const canvas = document.getElementById('code-reveal');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const word = 'KimuDev';
    const glyphs = '01ABCDEFGHIJKLMNOPQRSTUVWXYZ$%#@!<>/\\{}[]*+-';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let cell = 16;
    let cols = 0;
    let rows = 0;
    let columns = [];
    let targetSet = new Set();
    let targetJitter = new Map(); // key -> 0..0.85, when it locks in during converge
    let locked = new Map(); // key -> glyph currently shown
    let dissolveJitter = new Map(); // key -> 0..0.85, when it unlocks during dissolve
    let phase = 'rain'; // rain -> converge -> glow -> hold -> dissolve -> rain, forever
    let phaseStart = performance.now();

    function colors() {
      const cs = getComputedStyle(document.documentElement);
      return {
        bg: cs.getPropertyValue('--bg').trim() || '#16140f',
        green: cs.getPropertyValue('--matrix-green').trim() || '#39d353',
        bright: cs.getPropertyValue('--matrix-green-bright').trim() || '#6effb0',
      };
    }
    const cachedColors = colors();

    function computeTargets() {
      targetSet = new Set();
      targetJitter = new Map();
      const off = document.createElement('canvas');
      off.width = width;
      off.height = height;
      const octx = off.getContext('2d');
      if (!octx) return;
      octx.fillStyle = '#000';
      octx.fillRect(0, 0, width, height);
      octx.fillStyle = '#fff';
      let fontSize = Math.floor(height * 0.55);
      octx.font = `bold ${fontSize}px sans-serif`;
      let textWidth = octx.measureText(word).width;
      while (textWidth > width * 0.92 && fontSize > 8) {
        fontSize -= 2;
        octx.font = `bold ${fontSize}px sans-serif`;
        textWidth = octx.measureText(word).width;
      }
      octx.textBaseline = 'middle';
      octx.fillText(word, (width - textWidth) / 2, height / 2 + fontSize * 0.04);
      const data = octx.getImageData(0, 0, width, height).data;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const px = Math.min(width - 1, c * cell + cell / 2);
          const py = Math.min(height - 1, r * cell + cell / 2);
          const idx = (Math.floor(py) * width + Math.floor(px)) * 4;
          if (data[idx] > 128) {
            const key = `${c},${r}`;
            targetSet.add(key);
            targetJitter.set(key, Math.random() * 0.85);
          }
        }
      }
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = Math.max(1, Math.floor(rect.width));
      height = Math.max(1, Math.floor(rect.height));
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Keep enough horizontal resolution to read the word on small screens.
      cell = Math.max(9, Math.min(16, Math.floor(width / 40)));
      cols = Math.max(1, Math.floor(width / cell));
      rows = Math.max(1, Math.floor(height / cell));

      computeTargets();
      columns = Array.from({ length: cols }, () => ({
        y: -Math.random() * rows,
        speed: 0.3 + Math.random() * 0.5,
      }));
      locked = new Map();
      phase = 'rain';
      phaseStart = performance.now();
    }

    function randomGlyph() {
      return glyphs[(Math.random() * glyphs.length) | 0];
    }

    // Advances every column's fall by one frame and draws it. Runs
    // unconditionally, every frame, regardless of phase — the rain never
    // stops falling underneath whatever the word overlay is doing.
    function stepRain(green) {
      ctx.fillStyle = green;
      for (let c = 0; c < columns.length; c++) {
        const col = columns[c];
        col.y += col.speed;
        const r = Math.floor(col.y);
        if (r >= 0 && r < rows) {
          ctx.fillText(randomGlyph(), c * cell, r * cell);
        }
        if (col.y * cell > height + cell * 4) {
          col.y = -Math.random() * rows * 0.5;
          col.speed = 0.3 + Math.random() * 0.5;
        }
      }
    }

    function drawLocked(color, blur) {
      if (blur) {
        ctx.shadowColor = color;
        ctx.shadowBlur = blur;
      }
      ctx.fillStyle = color;
      for (const [key, ch] of locked) {
        const [c, r] = key.split(',').map(Number);
        ctx.fillText(ch, c * cell, r * cell);
      }
      if (blur) {
        ctx.shadowBlur = 0;
        ctx.shadowColor = 'transparent';
      }
    }

    function drawStatic() {
      // No animation at all — used for prefers-reduced-motion.
      const { bg, bright } = cachedColors;
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, width, height);
      ctx.font = `${Math.max(8, cell - 2)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      ctx.textBaseline = 'top';
      for (const key of targetSet) locked.set(key, randomGlyph());
      drawLocked(bright, 0);
    }

    function draw(now) {
      const { bg, green, bright } = cachedColors;
      ctx.fillStyle = hexToRgba(bg, 0.14);
      ctx.fillRect(0, 0, width, height);
      ctx.font = `${Math.max(8, cell - 2)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      ctx.textBaseline = 'top';

      const elapsed = now - phaseStart;
      stepRain(green);

      if (phase === 'rain') {
        if (elapsed > RAIN_GAP_MS) {
          locked = new Map();
          phase = 'converge';
          phaseStart = now;
        }
      } else if (phase === 'converge') {
        // Cells lock in at a randomized point in the window, as if the
        // falling rain itself is the thing depositing each letter.
        const progress = elapsed / CONVERGE_MS;
        for (const key of targetSet) {
          if (!locked.has(key) && progress >= targetJitter.get(key)) {
            locked.set(key, randomGlyph());
          }
        }
        drawLocked(bright, 0);
        if (locked.size >= targetSet.size) {
          phase = 'glow';
          phaseStart = now;
        }
      } else if (phase === 'glow') {
        const progress = Math.min(1, elapsed / GLOW_MS);
        const pulse = Math.sin(progress * Math.PI); // 0 -> 1 -> 0
        drawLocked(bright, pulse * 14);
        if (progress >= 1) {
          phase = 'hold';
          phaseStart = now;
        }
      } else if (phase === 'hold') {
        drawLocked(bright, 0);
        if (elapsed > HOLD_MS) {
          dissolveJitter = new Map();
          for (const key of locked.keys()) dissolveJitter.set(key, Math.random() * 0.85);
          phase = 'dissolve';
          phaseStart = now;
        }
      } else if (phase === 'dissolve') {
        // Cells unlock at a randomized point in the window, so the rain
        // visibly erodes the word away rather than it vanishing at once.
        const progress = elapsed / DISSOLVE_MS;
        for (const key of Array.from(locked.keys())) {
          if (progress >= dissolveJitter.get(key)) locked.delete(key);
        }
        drawLocked(bright, 0);
        if (locked.size === 0 || elapsed > DISSOLVE_MS) {
          locked = new Map();
          phase = 'rain';
          phaseStart = now;
        }
      }

      requestAnimationFrame(draw);
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 150);
    });

    resize();

    if (reduced) {
      drawStatic();
    } else {
      requestAnimationFrame(draw);
    }
  }

  document.addEventListener('DOMContentLoaded', initCodeReveal);
</script>
