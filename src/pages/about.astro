---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="About"
  description="KimuDev builds apps and websites — standard builds and fully custom ones."
>
  <section class="section page-hero">
    <div class="wrap">
      <h1>About</h1>
      <p class="lede">
        KimuDev builds apps and websites — a standard build for
        something that needs to exist fast, or a fully custom one for
        something a template can't hold. See
        <a href={withBase('services/')}>Services</a> for how each one
        actually runs, or <a href={withBase('work/')}>Work</a> for
        what we've shipped.
      </p>
    </div>
  </section>
</BaseLayout>
