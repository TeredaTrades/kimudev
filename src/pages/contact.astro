---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with KimuDev about a Starter or custom build."
>
  <section class="section page-hero">
    <div class="wrap">
      <h1>Get in touch</h1>
      <p class="lede">
        Tell us what you're building, roughly who it's for, and
        whether you're picturing something fast (Starter) or something
        that has to fit your exact workflow (Custom). We'll reply with
        which track fits and what we'd need to scope it properly.
      </p>
      <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </section>
</BaseLayout>
